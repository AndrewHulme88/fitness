{
  "openapi": "3.1.1",
  "info": {
    "title": "Fitness Coach API",
    "version": "v1"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["Program"],
        "summary": "Check API liveness",
        "operationId": "GetHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/profiles": {
      "post": {
        "tags": ["Profiles"],
        "summary": "Create a training profile from onboarding choices",
        "operationId": "CreateTrainingProfile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTrainingProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrainingProfileResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/profiles/{profileId}": {
      "get": {
        "tags": ["Profiles"],
        "summary": "Get a training profile",
        "operationId": "GetTrainingProfile",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrainingProfileResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateTrainingProfileRequest": {
        "required": ["goals", "experience", "availableEquipment", "unitSystem"],
        "type": "object",
        "properties": {
          "goals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingGoal"
            }
          },
          "experience": {
            "$ref": "#/components/schemas/TrainingExperience"
          },
          "availableEquipment": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EquipmentType"
            }
          },
          "unitSystem": {
            "$ref": "#/components/schemas/UnitSystem"
          }
        },
        "additionalProperties": false
      },
      "EquipmentType": {
        "enum": [
          "bodyweight",
          "dumbbells",
          "barbell",
          "bench",
          "squatRack",
          "cableMachine",
          "resistanceBands",
          "cardioEquipment"
        ]
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": ["null", "string"]
          },
          "title": {
            "type": ["null", "string"]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["null", "integer", "string"],
            "format": "int32"
          },
          "detail": {
            "type": ["null", "string"]
          },
          "instance": {
            "type": ["null", "string"]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "additionalProperties": false
      },
      "TrainingExperience": {
        "enum": ["beginner", "intermediate", "advanced"]
      },
      "TrainingGoal": {
        "enum": ["buildStrength", "buildMuscle", "generalFitness"]
      },
      "TrainingProfileResponse": {
        "required": [
          "id",
          "goals",
          "experience",
          "availableEquipment",
          "unitSystem",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "goals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingGoal"
            }
          },
          "experience": {
            "$ref": "#/components/schemas/TrainingExperience"
          },
          "availableEquipment": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EquipmentType"
            }
          },
          "unitSystem": {
            "$ref": "#/components/schemas/UnitSystem"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "UnitSystem": {
        "enum": ["metric", "imperial"]
      }
    }
  },
  "tags": [
    {
      "name": "Program"
    },
    {
      "name": "Profiles"
    }
  ]
}
