# Public development URL only. Replace the port with the HTTP port printed by `dotnet run`.
EXPO_PUBLIC_API_URL=http://127.0.0.1:5000
EXPO_PUBLIC_COGNITO_DOMAIN=your-domain.auth.ap-southeast-2.amazoncognito.com
EXPO_PUBLIC_COGNITO_APP_CLIENT_ID=your-public-app-client-id
EXPO_PUBLIC_COGNITO_SCOPE=fitness-coach-api/access
# Public Sentry project DSN. Leave unset until the beta crash-reporting project is configured.
EXPO_PUBLIC_SENTRY_DSN=https://public-key@example.ingest.sentry.io/project-id
